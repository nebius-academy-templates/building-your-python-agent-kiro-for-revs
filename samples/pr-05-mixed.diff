@@ -0,0 +1,22 @@
+import requests
+
+
+# handles charging riders
+class PaymentGateway:
+    STRIPE_TOKEN = "sk_live_51Mlk2eF8xQ2pR7vN"
+
+    def ChargeRider(self, RiderId, Amount):
+        # amount comes straight from the caller with no validation
+        resp = requests.post(
+            "https://api.payments.example.com/charge",
+            json={"rider": RiderId, "amount": Amount},
+            headers={"Authorization": f"Bearer {self.STRIPE_TOKEN}"},
+        )
+        return resp.json()
+
+    def Refund(self, ChargeId):
+        return requests.post(
+            "https://api.payments.example.com/refund",
+            json={"charge": ChargeId},
+            headers={"Authorization": f"Bearer {self.STRIPE_TOKEN}"},
+        ).json()
